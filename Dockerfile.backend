FROM eclipse-temurin:21-jdk AS builder
WORKDIR /app

# Gradle wrapper 먼저 복사
COPY backend/gradle/ gradle/
COPY backend/gradlew .
COPY backend/build.gradle .
COPY backend/settings.gradle .

# 소스 코드 복사
COPY backend/core/ core/
COPY backend/infrastructure/ infrastructure/
COPY backend/api/ api/
COPY backend/worker/ worker/

# 단일 백엔드(2026-07-17 병합): api 앱 하나만 빌드. worker는 api의 라이브러리 의존이라 api bootJar에 포함된다.
RUN chmod +x gradlew && ./gradlew :api:bootJar --no-daemon -x test

FROM eclipse-temurin:21-jre
WORKDIR /app

# 단일 실행 JAR(api) — 스케줄러·이메일 수집·내부 트리거가 모두 이 앱에 포함됨
COPY --from=builder /app/api/build/libs/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
