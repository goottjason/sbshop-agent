FROM eclipse-temurin:21-jdk AS builder
WORKDIR /app

# Gradle wrapper 먼저 복사
COPY backend/gradle/ gradle/
COPY backend/gradlew .
COPY backend/build.gradle .
COPY backend/settings.gradle .

# 소스 코드 복사
COPY backend/core/ core/
COPY backend/infrastructure/ infrastructure/
COPY backend/api/ api/
COPY backend/worker/ worker/

RUN chmod +x gradlew && ./gradlew :api:bootJar :worker:bootJar --no-daemon -x test

# 런타임: Debian 기반 JRE (서버 ARM64 — Google Chrome ARM64 미제공이라 Chromium 사용)
FROM bellsoft/liberica-openjre-debian:21
WORKDIR /app

# ESM+(G마켓/옥션) Selenium 스크래핑용 Chromium + 버전 일치 chromedriver (Debian arm64, 배포판 패키지)
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium chromium-driver \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
ENV CHROME_BIN=/usr/bin/chromium

# API JAR와 Worker JAR 모두 복사
COPY --from=builder /app/api/build/libs/*.jar api.jar
COPY --from=builder /app/worker/build/libs/*.jar worker.jar

# start.sh 복사
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

EXPOSE 8080 8081

ENTRYPOINT ["/app/start.sh"]
