# ===========================================
# sbshop-agent 환경 변수 설정
# ===========================================
# 이 파일을 .env로 복사하여 사용하세요.
# .env 파일은 Git에서 제외됩니다.

# ===========================================
# PostgreSQL (공유 DB 서버)
# ===========================================
POSTGRES_PASSWORD=your-secure-password

# ===========================================
# sbshop-agent DB 설정
# ===========================================
DB_URL=jdbc:postgresql://postgres:5432/sbshop
DB_USERNAME=sbshop
DB_PASSWORD=your-secure-password

# ===========================================
# Coupang API
# ===========================================
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_CLIENT_ID=

# ===========================================
# SmartStore API
# ===========================================
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=
SMARTSTORE_MALL_ID=

# ===========================================
# 11st API
# ===========================================
ELEVENST_CLIENT_ID=
ELEVENST_CLIENT_SECRET=

# ===========================================
# ESM+ API
# ===========================================
ESMPLUS_USER_ID=
ESMPLUS_PASSWORD=
ESMPLUS_CLIENT_ID=
ESMPLUS_CLIENT_SECRET=

# ===========================================
# Email (Gmail IMAP)
# ===========================================
EMAIL_USERNAME_1=shouldbe.shopping@gmail.com
EMAIL_PASSWORD_1=your-app-password
EMAIL_USERNAME_2=369butterfly369@gmail.com
EMAIL_PASSWORD_2=your-app-password

# ===========================================
# UNIPASS (통관)
# ===========================================
UNIPASS_API_KEY=
UNIPASS_USER_ID=

# ===========================================
# MariaDB 소스 (마이그레이션용)
# ===========================================
# pgloader 사용 시 필요
CAFE24_DB_HOST=goottjason.cafe24.com
CAFE24_DB_PORT=3306
CAFE24_DB_NAME=goottjason
CAFE24_DB_USER=goottjason
CAFE24_DB_PASSWORD=mimi1570!!@
