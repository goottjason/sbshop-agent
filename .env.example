# ===========================================
# sbshop-agent 환경 변수 설정
# ===========================================
# 이 파일을 .env로 복사하여 사용하세요.
# .env 파일은 Git에서 제외됩니다.

# ===========================================
# PostgreSQL (공유 DB 서버)
# ===========================================
POSTGRES_PASSWORD=your-secure-password

# ===========================================
# sbshop-agent DB 설정
# ===========================================
DB_URL=jdbc:postgresql://postgres:5432/sbshop
DB_USERNAME=sbshop
DB_PASSWORD=your-secure-password

# ===========================================
# Coupang API
# ===========================================
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_CLIENT_ID=

# ===========================================
# SmartStore API
# ===========================================
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=

# ===========================================
# 11st API
# ===========================================
ELEVENST_CLIENT_ID=
ELEVENST_CLIENT_SECRET=

# ===========================================
# ESM+ API
# ===========================================
ESMPLUS_USER_ID=
ESMPLUS_PASSWORD=
ESMPLUS_CLIENT_ID=
ESMPLUS_CLIENT_SECRET=

# ===========================================
# Email (Gmail IMAP)
# ===========================================
# 소싱 계정이 여러 개면 EMAIL_ACCOUNTS 한 줄로 N개 Gmail 계정을 등록한다(권장).
#   형식: user1@gmail.com:app-pass1, user2@gmail.com:app-pass2  (쉼표 또는 줄바꿈 구분)
#   - 전 계정 Gmail 전제. 비-Gmail(naver/hanmail/nate 등)은 대표 Gmail로 IMAP 포워딩 후 등록.
#   - 앱 비밀번호는 Gmail 2단계 인증 → 앱 비밀번호에서 발급(공백 표기 그대로 넣어도 됨).
EMAIL_ACCOUNTS=user1@gmail.com:your-app-password-1, user2@gmail.com:your-app-password-2
#
# (레거시 호환) 슬롯식도 계속 동작하며 EMAIL_ACCOUNTS와 병합된다:
# EMAIL_USERNAME_1=your-email-1@gmail.com
# EMAIL_PASSWORD_1=your-app-password-1

# ===========================================
# UNIPASS (통관)
# ===========================================
UNIPASS_API_KEY=
UNIPASS_USER_ID=

# ===========================================
# Cloudflare R2 (이미지 호스팅)
# ===========================================
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=sbshop-images
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ===========================================
# Cafe24 API (상품 동기화용)
# ===========================================
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=

# ===========================================
# MariaDB 소스 (마이그레이션용)
# ===========================================
# pgloader 사용 시 필요
CAFE24_DB_HOST=goottjason.cafe24.com
CAFE24_DB_PORT=3306
CAFE24_DB_NAME=goottjason
CAFE24_DB_USER=goottjason
CAFE24_DB_PASSWORD=your-cafe24-db-password
