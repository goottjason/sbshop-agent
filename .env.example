# ============================================================
# sbshop-agent 환경 변수 (.env 템플릿)
# ============================================================
# 이 파일을 .env로 복사해 값을 채운다. .env는 Git에서 제외된다.
# 로컬과 서버(~/projects/sbshop-agent/.env)의 키 목록은 같게 유지한다.
#   소싱 API 키만 서버로 옮기려면:  ./sync-env.sh
#
# ⚠️ 마켓 API 자격증명(쿠팡·스토어·11번가·Cafe24)은 **DB가 단일 소스**다.
#    화면 [설정 및 연동]에서 저장하면 sb_market_credential에 들어가고, 코드는 DB를 먼저
#    보고 없을 때만 아래 env로 폴백한다(CoupangRestClient·SmartstoreRestClient 등).
#    운영에서 이 항목들이 비어 있는 것은 정상이다.

# ── DB ────────────────────────────────────────────────────────
# compose가 DB_PASSWORD를 PG_PASSWORD 값으로 채워 넣는다.
PG_PASSWORD=your-secure-password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sbshop
DB_USERNAME=sbshop

# ── 마켓 자격증명 (DB 우선 · env는 폴백) ───────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=

# ── 이미지 호스팅 (Cloudflare R2) ─────────────────────────────
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=sbshop-images
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── 이메일 수집 ───────────────────────────────────────────────
# 소싱 계정들은 각자 Gmail '자동전달'로 아래 중앙 계정 인박스에 메일을 모으고,
# 시스템은 이 중앙 계정 하나만 IMAP으로 읽는다(앱 비밀번호 1개면 됨).
EMAIL_CENTRAL_USERNAME=central@gmail.com
EMAIL_CENTRAL_PASSWORD=your-app-password
# 자동전달을 못 거는 계정(비-Gmail 등)은 직접 수집. user:pass 쉼표/줄바꿈 구분.
# IMAP host는 도메인으로 자동 판별(gmail/naver/daum/nate, 그 외 gmail 폴백).
EMAIL_ACCOUNTS=

# ── 신규 상품 등록 자동화(소싱 파이프라인) ─────────────────────
# 전부 선택사항. 비워 두어도 파이프라인은 동작하며 해당 신호만 빠진다.
# 발급 방법: docs/design/api-key-setup.md

# 네이버 검색 API(쇼핑) — 경쟁 상품 수 · 국내 최저가  [developers.naver.com]
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# 네이버 검색광고 API(키워드도구) — 월간 검색량 · 연관 키워드  [searchad.naver.com]
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# OpenCode Zen — 한글 상품명·검색키워드 생성(무료 모델)  [opencode.ai/auth]
ZEN_API_KEY=

# Cafe24 마켓플러스(mp.cafe24.com) 로그인 — G마켓·옥션 전송 자동화용
CAFE24_MP_USERNAME=
CAFE24_MP_PASSWORD=

# ============================================================
# 아래는 미설정이 정상 — 코드 기본값으로 동작한다.
# 기본값을 바꿔야 할 때만 .env에 추가한다.
# ============================================================
# COUPANG_CLIENT_ID=           # 쿠팡 vendorId. DB 자격증명에 있으면 불필요
# ELEVENST_CLIENT_ID=          # 11번가 API 키. DB 자격증명에 있으면 불필요
# INTERNAL_API_TOKEN=          # 내부 트리거 API 공유시크릿. 미설정 시 가드 비활성
# DDL_AUTO=update              # 스키마 자동반영. 문제 시 none/validate로 낮춤
# ZEN_MODELS=                  # 기본: nemotron-3-ultra-free,ling-3.0-flash-free
#
# 마켓 등록 계정 고정값 — application.yml에 라이브 검증 기본값이 들어 있다.
# MARKET_COUPANG_OUTBOUND_CODE=1206157
# MARKET_COUPANG_RETURN_CENTER=1000519746
# MARKET_SMARTSTORE_AS_TEL=010-2597-2480
# MARKET_ELEVENST_ADDR_SEQ_OUT=5     # 미국 출고지
# MARKET_ELEVENST_ADDR_SEQ_IN=3      # 국내 반품지
# MARKET_CAFE24_CATEGORY_NO=         # 미설정 시 쇼핑몰 분류 자동 조회
#
# ── 제거됨(2026-07-27) — 코드에서 참조하지 않아 혼란만 주던 항목 ──
#   POSTGRES_PASSWORD, DB_URL            : compose가 PG_PASSWORD/DB_* 로 구성
#   ELEVENST_CLIENT_SECRET               : 미사용
#   ESMPLUS_*                            : ESM+는 Selenium 스크래핑(자격증명 DB)
#   CAFE24_* (MALL_ID·CLIENT_*·REDIRECT) : Cafe24는 OAuth 토큰을 DB에서 관리
#   CAFE24_DB_*                          : 1회성 MariaDB 마이그레이션용(종료)
#   UNIPASS_*                            : 통관 조회는 GSI Express 스크래핑으로 대체
