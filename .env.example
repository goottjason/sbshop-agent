# ===========================================
# sbshop-agent 환경 변수 설정
# ===========================================
# 이 파일을 .env로 복사하여 사용하세요.
# .env 파일은 Git에서 제외됩니다.

# ===========================================
# PostgreSQL (공유 DB 서버)
# ===========================================
POSTGRES_PASSWORD=your-secure-password

# ===========================================
# sbshop-agent DB 설정
# ===========================================
DB_URL=jdbc:postgresql://postgres:5432/sbshop
DB_USERNAME=sbshop
DB_PASSWORD=your-secure-password

# ===========================================
# Coupang API
# ===========================================
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_CLIENT_ID=

# ===========================================
# SmartStore API
# ===========================================
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=

# ===========================================
# 11st API
# ===========================================
ELEVENST_CLIENT_ID=
ELEVENST_CLIENT_SECRET=

# ===========================================
# ESM+ API
# ===========================================
ESMPLUS_USER_ID=
ESMPLUS_PASSWORD=
ESMPLUS_CLIENT_ID=
ESMPLUS_CLIENT_SECRET=

# ===========================================
# Email (Gmail IMAP) — 중앙 계정 방식
# ===========================================
# 소싱 계정들은 각자 Gmail '자동전달'로 아래 중앙 계정 인박스에 메일을 모으고,
# 시스템은 이 중앙 계정 하나만 IMAP으로 읽는다(앱 비밀번호 1개면 됨).
#   - 앱 비밀번호: 중앙 계정의 Gmail 2단계 인증 → 앱 비밀번호에서 발급(공백 표기 그대로 넣어도 됨).
EMAIL_CENTRAL_USERNAME=central@gmail.com
EMAIL_CENTRAL_PASSWORD=your-app-password
#
# 자동전달을 못 거는 계정(비-Gmail 등)은 EMAIL_ACCOUNTS로 직접 수집(중앙 계정과 병합).
#   형식: user1@naver.com:pass1, user2@daum.net:pass2  (쉼표/줄바꿈 구분)
#   - IMAP host는 이메일 도메인으로 자동 판별: gmail→imap.gmail.com, naver→imap.naver.com,
#     hanmail/daum→imap.daum.net, nate→imap.mail.nate.com (그 외는 gmail 폴백).
#   - 각 계정에서 IMAP 사용 ON + (2단계 인증 시)앱 비밀번호 필요.
# EMAIL_ACCOUNTS=

# ===========================================
# UNIPASS (통관)
# ===========================================
UNIPASS_API_KEY=
UNIPASS_USER_ID=

# ===========================================
# Cloudflare R2 (이미지 호스팅)
# ===========================================
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=sbshop-images
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ===========================================
# Cafe24 API (상품 동기화용)
# ===========================================
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=

# ===========================================
# MariaDB 소스 (마이그레이션용)
# ===========================================
# pgloader 사용 시 필요
CAFE24_DB_HOST=goottjason.cafe24.com
CAFE24_DB_PORT=3306
CAFE24_DB_NAME=goottjason
CAFE24_DB_USER=goottjason
CAFE24_DB_PASSWORD=your-cafe24-db-password
